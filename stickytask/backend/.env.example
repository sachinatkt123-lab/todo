# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stickytask

# Server
PORT=3001

# AI provider (leave empty to use heuristic fallback instead of a real model)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini

# Conversational AI assistant uses the same AI_PROVIDER/keys above.
# With no key set, the assistant runs a built-in offline heuristic so all
# features still work locally.
